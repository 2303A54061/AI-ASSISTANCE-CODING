# TASK 5: PICKLE VS JSON
# ====================================
print("\n====================================")
print("TASK 5: DATA SERIALIZATION")
print("====================================")

# ❌ Insecure (Pickle)
print("\n[Insecure Pickle]")

import pickle

data = {"user": "admin"}

with open("data.pkl", "wb") as f:
    pickle.dump(data, f)

with open("data.pkl", "rb") as f:
    loaded = pickle.load(f)

print("Loaded (Pickle):", loaded)


# ✅ Secure (JSON)
print("\n[Secure JSON]")

import json

with open("data.json", "w") as f:
    json.dump(data, f)

with open("data.json", "r") as f:
    loaded = json.load(f)

print("Loaded (JSON):", loaded)


