# ✅ Secure Version
import re

print("\n[Secure Login]")

VALID_USERNAME = "admin"
VALID_PASSWORD = "1234"

def is_valid_input(text):
    """
    Allow only alphanumeric input (3–20 characters).
    """
    return bool(re.fullmatch(r"[A-Za-z0-9]{3,20}", text))

username = "admin123"
password = "1234"

if not is_valid_input(username) or not is_valid_input(password):
    print("Invalid input format")
elif username == VALID_USERNAME and password == VALID_PASSWORD:
    print("Login successful")
else:
    print("Invalid credentials")


