# ✅ Secure
print("\n[Secure File Access]")

import os

ALLOWED_FILES = ["data.txt"]

file_name = "data.txt"

if file_name not in ALLOWED_FILES:
    print("Access denied")
else:
    with open(file_name, "r") as f:
        print(f.read())


