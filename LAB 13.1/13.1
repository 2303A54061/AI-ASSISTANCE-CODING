def calculate_total(price):
    """
    Calculate total price including 18% tax.
    """
    tax = price * 0.18
    return price + tax


print("\n---- Task 3 Output ----")
print("Total Price:", calculate_total(250))
print("Total Price:", calculate_total(500))


