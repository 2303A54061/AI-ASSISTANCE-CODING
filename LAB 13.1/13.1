# TASK 1: Remove Code Duplication
# -------------------------------
def calculate_rectangle_metrics(length, width):
    """
    Calculate area and perimeter of a rectangle.
    """
    area = length * width
    perimeter = 2 * (length + width)
    return area, perimeter


print("---- Task 1 Output ----")
for l, w in [(5, 10), (7, 12), (10, 15)]:
    area, perimeter = calculate_rectangle_metrics(l, w)
    print(f"Area of Rectangle: {area}")
    print(f"Perimeter of Rectangle: {perimeter}")


# -------------------------------------------
# TASK 2: Optimize Loops & Compare Performance
# -------------------------------------------
import time

names = ["Alice", "Bob", "Charlie", "David"]
search_names = ["Charlie", "Eve", "Bob"]

print("\n---- Task 2 Output ----")

# Before Optimization
start = time.time()
for s in search_names:
    found = False
    for n in names:
        if s == n:
            found = True
    if found:
        print(f"{s} is in the list")
    else:
        print(f"{s} is not in the list")
end = time.time()
print("Time (Before):", end - start)


# After Optimization
start = time.time()
name_set = set(names)

for s in search_names:
    if s in name_set:
        print(f"{s} is in the list")
    else:
        print(f"{s} is not in the list")
end = time.time()
print("Time (After):", end - start)


