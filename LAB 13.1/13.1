# TASK 6: Reusable Grading Function
# -------------------------------------------
def calculate_grade(marks):
    """
    Return grade based on marks.
    """
    if marks >= 90:
        return "Grade A"
    elif marks >= 75:
        return "Grade B"
    else:
        return "Grade C"


print("\n---- Task 6 Output ----")
print(calculate_grade(85))
print(calculate_grade(72))


# -------------------------------------------
# TASK 7: Convert Procedural Code to Functions
# -------------------------------------------
def get_input():
    """
    Provide input value (fixed for testing).
    """
    return 5  # fixed input to avoid manual entry


def calculate_square(num):
    """
    Calculate square of a number.
    """
    return num * num


def display_result(result):
    """
    Display the result.
    """
    print("Square:", result)


print("\n---- Task 7 Output ----")
num = get_input()
result = calculate_square(num)
display_result(result)


